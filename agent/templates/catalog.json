{
  "_about": "Ready-made site templates for site_template. Each entry is an upstream open-source project pinned to an exact version, plus our patch (packs/<id>.patch). Only permissive licenses (MIT, Apache-2.0, BSD) or file-level copyleft (MPL-2.0) are listed; keep the upstream LICENSE file in every generated project. status: adapted = patched and tested end to end; listed = pinned and license-checked, used as upstream ships it.",
  "templates": [
    {
      "id": "ecommerce-next",
      "title": "E-commerce store + headless CMS (Next.js, Payload)",
      "category": "ecommerce",
      "framework": "next",
      "status": "adapted",
      "license": "MIT",
      "upstream": "https://github.com/payloadcms/payload/tree/main/templates/ecommerce",
      "source": {
        "type": "create",
        "command": "npx -y create-payload-app@3.90.2 -n {name} -t ecommerce --db sqlite --db-connection-string file:./{name}.db --no-agent --use-npm --no-deps",
        "creates": "{name}"
      },
      "patch": "packs/ecommerce-next.patch",
      "env": {
        "SITE_NAME": "{site_name}",
        "COMPANY_NAME": "{company}"
      },
      "install": "npm install",
      "dev": "npm run dev",
      "port": 3000,
      "provides": [
        "products",
        "variants",
        "categories",
        "carts",
        "orders",
        "customer accounts",
        "admin panel at /admin",
        "Stripe checkout",
        "blog pages"
      ],
      "after_create": [
        "Start it (dev) and open /admin to create the first admin user.",
        "Demo content: log in, then POST /next/seed (or use the admin dashboard's seed button).",
        "Products need inventory > 0 to be sold."
      ]
    },
    {
      "id": "ecommerce-nuxt",
      "title": "E-commerce storefront (Nuxt/Vue) on the Payload CMS backend",
      "category": "ecommerce",
      "framework": "nuxt",
      "status": "adapted",
      "license": "MIT",
      "upstream": "https://github.com/zackha/nuxtcommerce",
      "source": {
        "type": "git",
        "repo": "https://github.com/zackha/nuxtcommerce",
        "commit": "db4547113f47e9dd74a320d1fbdfc4db73c81676"
      },
      "patch": "packs/ecommerce-nuxt.patch",
      "remove": [
        "pnpm-lock.yaml",
        ".wrangler",
        "wrangler.toml",
        ".github"
      ],
      "backend": "ecommerce-next",
      "env": {
        "PAYLOAD_URL": "{backend_url}",
        "PAYLOAD_EMAIL": "{admin_email}",
        "PAYLOAD_PASSWORD": "{admin_password}"
      },
      "install": "npm install",
      "dev": "npx nuxt dev --port {port}",
      "port": 3001,
      "provides": [
        "product grid, search, categories, colour/size variants",
        "cart in the browser",
        "cash-on-delivery checkout that creates Payload orders",
        "wishlist",
        "4 languages"
      ],
      "after_create": [
        "Needs a running ecommerce-next backend (PAYLOAD_URL).",
        "PAYLOAD_EMAIL / PAYLOAD_PASSWORD: an admin of that backend; the server uses it only to create orders."
      ],
      "replace": [
        {
          "file": "app/app.config.ts",
          "find": "name: 'NuxtCommerce'",
          "with": "name: '{site_name}'"
        },
        {
          "file": "app/app.config.ts",
          "find": "description: 'NuxtCommerce is a dynamic e-commerce solution developed with Nuxt 4 and GraphQL, tailored for WooCommerce.'",
          "with": "description: '{description}'"
        },
        {
          "file": "app/app.config.ts",
          "find": "primary: 'red'",
          "with": "primary: '{brand_color}'"
        },
        {
          "file": "app/components/AppFooter.vue",
          "find": "NuxtCommerce v{{",
          "with": "{site_name} v{{"
        }
      ],
      "defaults": {
        "brand_color": "red",
        "description": "{site_name}: shop online."
      }
    },
    {
      "id": "cms-strapi",
      "title": "Headless CMS (Strapi 5, Community Edition) — content types and REST/GraphQL API for any front-end",
      "category": "cms",
      "framework": "node",
      "status": "adapted",
      "license": "MIT",
      "upstream": "https://github.com/strapi/strapi",
      "source": {
        "type": "create",
        "command": "npx -y create-strapi@5.56.0 {name} --non-interactive --skip-cloud --no-run --no-install --no-git-init --no-example --ts --dbclient sqlite --dbfile .tmp/data.db --use-npm",
        "creates": "{name}"
      },
      "env": {
        "PORT": "{port}"
      },
      "install": "npm install",
      "dev": "npm run develop",
      "port": 1337,
      "provides": [
        "admin panel at /admin",
        "content types (strapi_cms create_type)",
        "REST API /api/<type>",
        "media library",
        "users & permissions",
        "i18n",
        "SQLite by default (PostgreSQL/MySQL via config/database.ts)"
      ],
      "notes": "Community Edition is MIT as long as you do not use code under an ee/ folder (Enterprise features) or a Strapi Cloud account — the pack skips cloud login.",
      "after_create": [
        "npm install && npm run develop, then strapi_cms action=setup (email, password) creates the admin and an API token.",
        "Add content types with strapi_cms action=create_type; manage entries with list/create/update/delete."
      ]
    },
