+// server/utils/payload.ts
+// Payload CMS (headless) backend for the storefront, in place of WooCommerce + WPGraphQL.
+// Payload's REST API is mapped to the shapes the pages already use (WooGraphQL-style nodes),
+// so the components stay as they were.
+import { createError } from 'h3';
+
+type Doc = Record<string, any>;
+
+function cfg() {
+  const { payloadUrl, payloadEmail, payloadPassword } = useRuntimeConfig();
+  return { base: String(payloadUrl || 'http://localhost:3000').replace(/\/+$/, ''), email: payloadEmail as string, password: payloadPassword as string };
+}
+
+let token: { value: string; exp: number } | null = null;
+
+/** Admin token for writes (orders); read endpoints are public for published content. */
+async function adminToken(): Promise<string | undefined> {
+  const { base, email, password } = cfg();
+  if (!email || !password) return undefined;
+  if (token && token.exp > Date.now() + 60_000) return token.value;
+  const res = await $fetch<{ token: string; exp: number }>(`${base}/api/users/login`, { method: 'POST', body: { email, password } });
+  token = { value: res.token, exp: res.exp * 1000 };
+  return token.value;
+}
+
+export async function payload<T = Doc>(path: string, opts: { method?: 'GET' | 'POST' | 'PATCH'; query?: Record<string, any>; body?: any; admin?: boolean } = {}): Promise<T> {
+  const { base } = cfg();
+  const headers: Record<string, string> = {};
+  if (opts.admin) {
+    const t = await adminToken();
+    if (t) headers.Authorization = `JWT ${t}`;
+  }
+  try {
+    return await $fetch<T>(`${base}/api${path}`, { method: opts.method ?? 'GET', query: opts.query, body: opts.body, headers });
+  } catch (error: any) {
+    throw createError({ statusCode: error?.statusCode || 502, statusMessage: error?.data?.errors?.[0]?.message || error?.message || 'Payload request failed' });
+  }
+}
+
+const money = (cents?: number | null) => (typeof cents === 'number' ? `$${(cents / 100).toFixed(2)}` : '');
+
+function mediaUrl(m: any): string {
+  const url = typeof m === 'object' && m ? m.url : '';
+  if (!url) return '';
+  return /^https?:/.test(url) ? url : cfg().base + url;
+}
+
+/** Lexical rich text (Payload's editor) → HTML for the description block. */
+export function lexicalToHtml(node: any): string {
+  if (!node) return '';
+  if (node.root) return lexicalToHtml(node.root);
+  const kids = (node.children ?? []).map(lexicalToHtml).join('');
+  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
+  switch (node.type) {
+    case 'root': return kids;
+    case 'text': {
+      let t = esc(node.text ?? '');
+      if (node.format & 1) t = `<strong>${t}</strong>`;
+      if (node.format & 2) t = `<em>${t}</em>`;
+      return t;
+    }
+    case 'linebreak': return '<br>';
+    case 'heading': return `<${node.tag || 'h3'}>${kids}</${node.tag || 'h3'}>`;
+    case 'list': return node.listType === 'number' ? `<ol>${kids}</ol>` : `<ul>${kids}</ul>`;
+    case 'listitem': return `<li>${kids}</li>`;
+    case 'quote': return `<blockquote>${kids}</blockquote>`;
+    case 'link': return `<a href="${esc(node.fields?.url ?? '#')}">${kids}</a>`;
+    default: return node.type === 'paragraph' ? `<p>${kids}</p>` : kids;
+  }
+}
+
+const optionsOf = (variant: Doc) => (variant.options ?? []).filter((o: any) => typeof o === 'object');
+
+/** Variant type names by id ("color", "size"): through a product, option.variantType is only an id. */
+let typeNames: { at: number; map: Map<string, string> } | null = null;
+export async function loadVariantTypes(): Promise<void> {
+  if (typeNames && Date.now() - typeNames.at < 5 * 60_000) return;
+  const res = await payload<{ docs: Doc[] }>('/variantTypes', { query: { limit: 100, depth: 0 } });
+  typeNames = { at: Date.now(), map: new Map(res.docs.map((t) => [String(t.id), `${t.name} ${t.label}`])) };
+}
+const typeName = (vt: any) => (typeof vt === 'object' && vt ? `${vt.name} ${vt.label}` : typeNames?.map.get(String(vt)) ?? '');
+const isType = (o: Doc, name: RegExp) => name.test(typeName(o.variantType));
+
+/** Colour options across a product's variants (each becomes its own page, as the storefront expects). */
+function colorsOf(p: Doc): Doc[] {
+  const seen = new Map<string, Doc>();
+  for (const v of p.variants?.docs ?? []) if (typeof v === 'object') for (const o of optionsOf(v)) if (isType(o, /colou?r/i)) seen.set(String(o.id), o);
+  return [...seen.values()];
+}
+
+const hasOption = (v: Doc, opt?: Doc) => !opt || optionsOf(v).some((o: Doc) => String(o.id) === String(opt.id));
+
+/** Variants of the chosen colour with a stock count, or the product itself as its only "variation". */
+function variationsOf(p: Doc, color?: Doc) {
+  const variants: Doc[] = (p.variants?.docs ?? []).filter((v: any) => typeof v === 'object' && hasOption(v, color));
+  if (!p.enableVariants || !variants.length) {
+    return [{ databaseId: `p${p.id}`, stockQuantity: p.inventory ?? 0, stockStatus: (p.inventory ?? 0) > 0 ? 'IN_STOCK' : 'OUT_OF_STOCK', attributes: { nodes: [{ value: 'one size' }] } }];
+  }
+  return variants.map((v) => ({
+    databaseId: `v${v.id}`,
+    stockQuantity: v.inventory ?? 0,
+    stockStatus: (v.inventory ?? 0) > 0 ? 'IN_STOCK' : 'OUT_OF_STOCK',
+    attributes: { nodes: optionsOf(v).filter((o: Doc) => !isType(o, /colou?r/i)).map((o: Doc) => ({ value: o.label ?? o.value })) },
+  }));
+}
+
+/** Gallery images, those tagged with the colour first (Payload gallery items may name a variant option). */
+function imagesOf(p: Doc, color?: Doc): string[] {
+  const gallery: Doc[] = p.gallery ?? [];
+  const optId = (g: Doc) => String(typeof g.variantOption === 'object' && g.variantOption ? g.variantOption.id : g.variantOption ?? '');
+  const tagged = color ? gallery.filter((g) => optId(g) === String(color.id)) : [];
+  const rest = gallery.filter((g) => !tagged.includes(g) && (!color || !optId(g) || optId(g) === 'undefined' || optId(g) === ''));
+  return [...tagged, ...(tagged.length ? [] : rest.length ? rest : gallery)].map((g) => mediaUrl(g?.image)).filter(Boolean);
+}
+
+/** A Payload product as a storefront product node. `colorKey` picks the colour page ("tshirt~white"). */
+export function toProductNode(p: Doc, detail = false, colorKey?: string): Doc {
+  const colors = colorsOf(p);
+  const want = colorKey?.toLowerCase();
+  const color = colors.find((c) => [c.value, c.label].some((x) => String(x).toLowerCase() === want)) ?? colors[0];
+  const images = imagesOf(p, color);
+  const first = images[0] || mediaUrl(p.meta?.image);
+  const price = p.priceInUSD ?? Math.min(...(p.variants?.docs ?? []).map((v: any) => v?.priceInUSD).filter((n: any) => typeof n === 'number'));
+  const category = (p.categories ?? []).find((c: any) => typeof c === 'object');
+  const node: Doc = {
+    databaseId: p.id,
+    sku: String(p.id),
+    slug: color && colorKey ? `${p.slug}~${color.value}` : p.slug,
+    name: p.title,
+    regularPrice: money(Number.isFinite(price) ? price : null),
+    salePrice: '',
+    image: { sourceUrl: first },
+    galleryImages: { nodes: (images.length ? images : [first]).map((sourceUrl: string) => ({ sourceUrl })) },
+    allPaStyle: { nodes: [{ name: category?.title ?? 'Product' }] },
+    allPaColor: { nodes: color ? [{ name: color.label }] : [] },
+  };
+  if (detail) {
+    node.description = lexicalToHtml(p.description);
+    node.variations = { nodes: variationsOf(p, color) };
+    // colour swatches: one "product" per colour, linked as /product/<slug>~<colour>-<id>
+    node.productTypes = {
+      nodes: colors.length > 1
+        ? [{ products: { nodes: colors.map((c) => ({ slug: `${p.slug}~${c.value}`, image: { sourceUrl: imagesOf(p, c)[0] || first }, allPaColor: { nodes: [{ name: c.label }] } })) } }]
+        : [],
+    };
+    node.related = { nodes: (p.relatedProducts ?? []).filter((r: any) => typeof r === 'object').map((r: Doc) => toProductNode(r)) };
+  }
+  return node;
+}
+
+const ORDER_FIELDS: Record<string, string> = { DATE: 'createdAt', PRICE: 'priceInUSD', TITLE: 'title', NAME: 'title' };
+export const sortOf = (field = 'DATE', order = 'DESC') => `${order === 'ASC' ? '' : '-'}${ORDER_FIELDS[field] ?? 'createdAt'}`;
+
+export async function categoryIdByName(name?: string): Promise<string | number | undefined> {
+  if (!name) return undefined;
+  const res = await payload<{ docs: Doc[] }>('/categories', { query: { 'where[or][0][title][equals]': name, 'where[or][1][slug][equals]': name, limit: 1 } });
+  return res.docs[0]?.id;
+}
