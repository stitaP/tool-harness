diff --git a/server/api/checkout.post.ts b/server/api/checkout.post.ts
index a7cf15a..b8183ea 100644
--- a/server/api/checkout.post.ts
+++ b/server/api/checkout.post.ts
@@ -1,8 +1,31 @@
 // server/api/checkout.post.ts
-import { checkoutMutation } from '~/gql/mutations/checkout';
-import { requestMutation } from '~~/server/utils/wpgraphql';
+// Cash-on-delivery order in Payload (orders need an admin token: PAYLOAD_EMAIL / PAYLOAD_PASSWORD).
+import { payload } from '~~/server/utils/payload';
+
+interface Line { key: string; quantity: number; variation?: { node?: { databaseId?: string; regularPrice?: string } } }
 
 export default defineEventHandler(async event => {
-  const body = await readBody(event);
-  return await requestMutation(event, checkoutMutation, { input: body });
+  const { billing, items = [] } = await readBody<{ billing: Record<string, string>; items?: Line[] }>(event);
+  if (!items.length) throw createError({ statusCode: 400, statusMessage: 'Cart is empty' });
+  // ids are numbers with SQLite/Postgres and strings with MongoDB
+  const id = (v: string) => (/^\d+$/.test(v) ? Number(v) : v);
+  const orderItems = items.map(l => {
+    const [product, variant] = l.key.split(':');
+    return { product: id(product), ...(variant ? { variant: id(variant) } : {}), quantity: l.quantity };
+  });
+  const amount = Math.round(items.reduce((s, l) => s + parseFloat(String(l.variation?.node?.regularPrice ?? '0')) * l.quantity, 0) * 100);
+  const res = await payload<{ doc: any }>('/orders', {
+    method: 'POST',
+    admin: true,
+    body: {
+      items: orderItems,
+      customerEmail: billing.email,
+      shippingAddress: { firstName: billing.firstName, lastName: billing.lastName, addressLine1: billing.address1, city: billing.city, phone: billing.phone },
+      amount,
+      currency: 'USD',
+      status: 'processing',
+    },
+  });
+  const order = res.doc;
+  return { checkout: { order: { total: `$${(amount / 100).toFixed(2)}`, orderNumber: String(order.id), date: order.createdAt, paymentMethodTitle: 'Cash on delivery' } } };
 });
