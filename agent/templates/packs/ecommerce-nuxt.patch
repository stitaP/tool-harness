@@ -1,8 +1,30 @@
 // server/api/cart/add.post.ts
-import { addToCartMutation } from '~/gql/mutations/addToCart';
-import { requestMutation } from '~~/server/utils/wpgraphql';
+// The cart lives in the browser (localStorage); this checks stock and returns the cart line.
+import { payload, toProductNode } from '~~/server/utils/payload';
 
 export default defineEventHandler(async event => {
-  const body = await readBody(event);
-  return await requestMutation(event, addToCartMutation, { input: body });
+  const { productId } = await readBody<{ productId: string }>(event);
+  const id = String(productId ?? '');
+  const isVariant = id.startsWith('v');
+  const raw = id.replace(/^[pv]/, '');
+  const variant = isVariant ? await payload<any>(`/variants/${raw}`, { query: { depth: 2 } }) : null;
+  const product = await payload<any>(`/products/${variant ? (typeof variant.product === 'object' ? variant.product.id : variant.product) : raw}`, { query: { depth: 2 } });
+  const stock = (variant ?? product).inventory ?? 0;
+  if (stock <= 0) throw createError({ statusCode: 409, statusMessage: 'Insufficient stock' });
+  const node = toProductNode(product);
+  const price = node.regularPrice;
+  const variantPrice = typeof variant?.priceInUSD === 'number' ? `$${(variant.priceInUSD / 100).toFixed(2)}` : price;
+  return {
+    addToCart: {
+      cartItem: {
+        key: `${product.id}:${variant?.id ?? ''}`,
+        quantity: 1,
+        product: { node: { sku: node.sku, slug: node.slug, name: node.name } },
+        variation: {
+          node: { name: variant?.title ?? node.name, databaseId: id, salePrice: '', regularPrice: variantPrice.replace('$', ''), stockQuantity: stock, stockStatus: 'IN_STOCK', image: node.image },
+          attributes: (variant?.options ?? []).filter((o: any) => typeof o === 'object').map((o: any) => ({ value: o.label ?? o.value })),
+        },
+      },
+    },
+  };
 });
