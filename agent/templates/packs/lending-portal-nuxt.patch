diff --git a/server/api/notify/overdue.post.ts b/server/api/notify/overdue.post.ts
new file mode 100644
index 0000000..89973af
--- /dev/null
+++ b/server/api/notify/overdue.post.ts
@@ -0,0 +1,12 @@
+// Overdue reminders to borrowers, collectors and investors. Run daily (e.g. stitaP /cron, or any scheduler):
+//   curl -X POST https://<portal>/api/notify/overdue?secret=<WEBHOOK_SECRET>
+import { allLoans, isActive, overdueOf } from '~~/server/utils/fineract'
+import { notifyOverdue } from '~~/server/utils/notify'
+
+export default defineEventHandler(async (event) => {
+  // access is checked in server/middleware/auth.ts (portal login, or ?secret= for machine calls)
+  const { limit = 50 } = getQuery(event) as { limit?: number }
+  const due = (await allLoans()).filter(l => isActive(l) && overdueOf(l) > 0).slice(0, Number(limit))
+  const sent = (await Promise.all(due.map(l => notifyOverdue(l)))).flat()
+  return { loans: due.length, messages: sent.length, dryRun: sent.every(s => s.status === 'dry-run') }
+})
diff --git a/server/api/portfolio.get.ts b/server/api/portfolio.get.ts
new file mode 100644
index 0000000..c7d7c80
--- /dev/null
+++ b/server/api/portfolio.get.ts
@@ -0,0 +1,32 @@
+import { allLoans, isActive, outstandingOf, overdueOf, money } from '~~/server/utils/fineract'
+
+/** Portfolio figures per currency (amounts in different currencies are never added together). */
+export default defineCachedEventHandler(async () => {
+  const loans = await allLoans()
+  const byCur = new Map<string, any[]>()
+  for (const l of loans) { const c = l.currency?.code ?? '?'; byCur.set(c, [...(byCur.get(c) ?? []), l]) }
+  const totals = [...byCur.entries()].map(([currency, ls]) => {
+    const active = ls.filter(isActive)
+    const outstanding = active.reduce((s, l) => s + outstandingOf(l), 0)
+    const overdueLoans = active.filter(l => overdueOf(l) > 0)
+    const atRisk = overdueLoans.reduce((s, l) => s + outstandingOf(l), 0)
+    return {
+      currency, loans: ls.length, active: active.length, overdueLoans: overdueLoans.length,
+      outstanding: money(outstanding, currency), overdue: money(overdueLoans.reduce((s, l) => s + overdueOf(l), 0), currency),
+      par: outstanding ? `${((atRisk / outstanding) * 100).toFixed(1)}%` : '0%',
+      disbursed: money(ls.reduce((s, l) => s + Number(l.summary?.principalDisbursed ?? 0), 0), currency)
+    }
+  }).sort((a, b) => b.active - a.active)
+  const main = totals[0]
+  return {
+    currency: main?.currency ?? 'INR',
+    stats: main ? [
+      { title: `Active loans (${main.currency})`, icon: 'i-lucide-landmark', value: String(main.active), to: '/loans' },
+      { title: 'Outstanding', icon: 'i-lucide-wallet', value: main.outstanding, to: '/loans' },
+      { title: 'Overdue', icon: 'i-lucide-alarm-clock', value: main.overdue, to: '/collections' },
+      { title: 'Portfolio at risk', icon: 'i-lucide-triangle-alert', value: main.par, to: '/collections' }
+    ] : [],
+    totals,
+    byStatus: Object.entries(loans.reduce((m: Record<string, number>, l) => ((m[l.status?.value ?? '?'] = (m[l.status?.value ?? '?'] ?? 0) + 1), m), {})).map(([status, count]) => ({ status, count }))
+  }
+}, { maxAge: 60 })
