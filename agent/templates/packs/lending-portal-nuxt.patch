@@ -0,0 +1,58 @@
+<script setup lang="ts">
+const f = reactive({ principal: 500000, rate: 12, months: 36, afterMonth: 12, amount: 100000, income: 60000, existingEmis: 5000, foir: 50 })
+const out = reactive<Record<string, any>>({})
+async function run(kind: string) {
+  out[kind] = await $fetch('/api/calc', { method: 'POST', body: { kind, ...f } })
+}
+const inr = (n: number) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(n ?? 0)
+onMounted(() => ['emi', 'flat', 'prepay', 'eligibility'].forEach(run))
+watch(f, () => ['emi', 'flat', 'prepay', 'eligibility'].forEach(run))
+</script>
+
+<template>
+  <PanelShell id="calculators" title="Calculators">
+    <div class="grid gap-3 sm:grid-cols-3">
+      <UFormField label="Loan amount (₹)"><UInputNumber v-model="f.principal" :step="10000" /></UFormField>
+      <UFormField label="Interest rate (% a year)"><UInputNumber v-model="f.rate" :step="0.25" /></UFormField>
+      <UFormField label="Tenure (months)"><UInputNumber v-model="f.months" /></UFormField>
+    </div>
+    <div class="grid gap-4 md:grid-cols-2">
+      <UCard>
+        <template #header><b>EMI (reducing balance)</b></template>
+        <div v-if="out.emi" class="text-sm space-y-1">
+          <div class="text-2xl font-semibold">{{ inr(out.emi.emi) }} <span class="text-sm text-muted">/ month</span></div>
+          <div>Total interest {{ inr(out.emi.totalInterest) }} · Total paid {{ inr(out.emi.total) }}</div>
+        </div>
+      </UCard>
+      <UCard>
+        <template #header><b>Flat vs reducing interest</b></template>
+        <div v-if="out.flat" class="text-sm space-y-1">
+          <div>Flat-rate EMI {{ inr(out.flat.emi) }} (interest {{ inr(out.flat.totalInterest) }})</div>
+          <div>Reducing-balance EMI {{ inr(out.flat.reducingEmi) }}</div>
+        </div>
+      </UCard>
+      <UCard>
+        <template #header><b>Part prepayment</b></template>
+        <div class="grid grid-cols-2 gap-2 mb-2">
+          <UFormField label="After EMI no."><UInputNumber v-model="f.afterMonth" /></UFormField>
+          <UFormField label="Prepay (₹)"><UInputNumber v-model="f.amount" :step="10000" /></UFormField>
+        </div>
+        <div v-if="out.prepay" class="text-sm space-y-1">
+          <div>Keep EMI: {{ out.prepay.keepEmi.monthsSaved }} months sooner, interest saved {{ inr(out.prepay.keepEmi.interestSaved) }}</div>
+          <div>Keep tenure: new EMI {{ inr(out.prepay.keepTerm.newEmi) }}, interest saved {{ inr(out.prepay.keepTerm.interestSaved) }}</div>
+        </div>
+      </UCard>
+      <UCard>
+        <template #header><b>Eligibility (FOIR)</b></template>
+        <div class="grid grid-cols-3 gap-2 mb-2">
+          <UFormField label="Monthly income"><UInputNumber v-model="f.income" :step="5000" /></UFormField>
+          <UFormField label="Existing EMIs"><UInputNumber v-model="f.existingEmis" :step="1000" /></UFormField>
+          <UFormField label="FOIR %"><UInputNumber v-model="f.foir" /></UFormField>
+        </div>
+        <div v-if="out.eligibility" class="text-sm">Up to <b>{{ inr(out.eligibility.maxLoan) }}</b> (EMI up to {{ inr(out.eligibility.maxEmi) }})</div>
+      </UCard>
+    </div>
+    <h3 class="font-semibold">Amortization schedule</h3>
+    <PageTable :rows="out.emi?.schedule?.map((r: any) => ({ ...r, emi: inr(r.emi), interest: inr(r.interest), principal: inr(r.principal), balance: inr(r.balance) }))" :columns="[{ key: 'month', label: 'Month' }, { key: 'emi', label: 'EMI' }, { key: 'principal', label: 'Principal' }, { key: 'interest', label: 'Interest' }, { key: 'balance', label: 'Balance' }]" />
+  </PanelShell>
+</template>
diff --git a/app/pages/collections.vue b/app/pages/collections.vue
new file mode 100644
index 0000000..c463913
--- /dev/null
+++ b/app/pages/collections.vue
@@ -0,0 +1,24 @@
+<script setup lang="ts">
+const { data, refresh } = await useFetch('/api/collections')
+const toast = useToast()
+const sending = ref(false)
+const columns = [{ key: 'account', label: 'Account' }, { key: 'client', label: 'Borrower' }, { key: 'overdue', label: 'Overdue' }, { key: 'daysOverdue', label: 'Days' }, { key: 'outstanding', label: 'Outstanding' }, { key: 'officer', label: 'Collector' }]
+async function remind() {
+  sending.value = true
+  try {
+    const r = await $fetch<any>('/api/notify/overdue', { method: 'POST' })
+    toast.add({ title: `${r.messages} WhatsApp update${r.messages === 1 ? '' : 's'} for ${r.loans} overdue loans`, description: r.dryRun ? 'Dry run: add WHATSAPP_TOKEN and WHATSAPP_PHONE_NUMBER_ID to send for real.' : undefined })
+  } catch (e: any) {
+    toast.add({ title: 'Reminders failed', description: e?.data?.statusMessage ?? e.message, color: 'error' })
+  } finally { sending.value = false; refresh() }
+}
+</script>
+
+<template>
+  <PanelShell id="collections" title="Collections">
+    <template #right><UButton icon="i-simple-icons-whatsapp" label="Send overdue reminders" :loading="sending" @click="remind" /></template>
+    <PageTable :rows="data" :columns="columns" :to="(r: any) => `/loans/${r.id}`" placeholder="Search borrower or collector…">
+      <template #overdue="{ row }"><span class="text-error font-medium">{{ row.overdue }}</span></template>
+    </PageTable>
+  </PanelShell>
+</template>
