@@ -0,0 +1,17 @@
+import { allLoans, isActive, outstandingOf, money, ownerOf } from '~~/server/utils/fineract'
+import { contacts } from '~~/server/utils/contacts'
+
+/** Loans owned by external investors (Fineract asset externalization), grouped by investor. */
+export default defineCachedEventHandler(async () => {
+  const active = (await allLoans(200)).filter(isActive)
+  const owners = await Promise.all(active.map(async l => ({ l, o: await ownerOf(l.id) })))
+  const book = contacts().investors
+  const byOwner = new Map<string, { loans: number; outstanding: number; currency: string }>()
+  for (const { l, o } of owners) {
+    const key = `${o?.owner || '(platform)'}|${l.currency?.code ?? 'INR'}`
+    const cur = byOwner.get(key) ?? { loans: 0, outstanding: 0, currency: l.currency?.code ?? 'INR' }
+    cur.loans++; cur.outstanding += outstandingOf(l)
+    byOwner.set(key, cur)
+  }
+  return [...byOwner.entries()].map(([k, v]) => { const owner = k.split('|')[0]; return { owner, currency: v.currency, name: book[owner]?.name ?? (owner === '(platform)' ? 'Platform (not sold)' : owner), whatsapp: book[owner]?.phone ?? '', loans: v.loans, outstanding: money(v.outstanding, v.currency) } })
+}, { maxAge: 300 })
