+// Fineract "Web" hook → WhatsApp updates. Register in Fineract: System > Manage Hooks > Web template,
+// Payload URL = https://<this-portal>/api/webhooks/fineract?secret=<WEBHOOK_SECRET>, events: LOAN DISBURSE, LOAN REPAYMENT (…).
+import { notifyLoanEvent } from '~~/server/utils/notify'
+
+export default defineEventHandler(async (event) => {
+  // access is checked in server/middleware/auth.ts (portal login, or ?secret= for machine calls)
+  const entity = String(getHeader(event, 'x-fineract-entity') ?? '').toUpperCase()
+  const action = String(getHeader(event, 'x-fineract-action') ?? '').toUpperCase()
+  const body = await readBody<Record<string, any>>(event).catch(() => ({} as Record<string, any>))
+  if (entity && entity !== 'LOAN') return { ignored: `${entity} ${action}` }
+  const loanId = body.loanId ?? body.resourceId ?? body.subResourceId
+  if (!loanId) return { ignored: 'no loanId in payload' }
+  const amount = Number(body.changes?.transactionAmount ?? body.transactionAmount ?? 0) || undefined
+  const sent = await notifyLoanEvent(action || 'STATUS', loanId, amount)
+  return { ok: true, sent: sent.map(s => ({ to: s.to, role: s.role, template: s.template, status: s.status })) }
+})
diff --git a/server/middleware/auth.ts b/server/middleware/auth.ts
new file mode 100644
index 0000000..3bf8752
--- /dev/null
+++ b/server/middleware/auth.ts
@@ -0,0 +1,22 @@
+// The portal shows borrowers' loans and can message them: everything needs a login (HTTP Basic, PORTAL_USER /
+// PORTAL_PASSWORD). Machine calls — Fineract's hook and the daily reminder job — use ?secret=WEBHOOK_SECRET instead.
+import { timingSafeEqual } from 'node:crypto'
+
+const same = (a: string, b: string) => a.length === b.length && timingSafeEqual(Buffer.from(a), Buffer.from(b))
+let warned = false
+
+export default defineEventHandler((event) => {
+  const c = useRuntimeConfig()
+  const path = event.path || ''
+  const machine = /^\/api\/(webhooks|notify)\//.test(path)
+  const secret = String(getQuery(event).secret ?? '')
+  if (machine && c.webhookSecret && secret && same(secret, String(c.webhookSecret))) return
+  if (!c.portalPassword) {
+    if (!warned) { console.warn('[lending] PORTAL_PASSWORD is not set: the portal is open to anyone who can reach it (fine on localhost only)'); warned = true }
+    return
+  }
+  const [user, pass] = Buffer.from(String(getHeader(event, 'authorization') ?? '').replace(/^Basic\s+/i, ''), 'base64').toString().split(':')
+  if (user && pass !== undefined && same(user, String(c.portalUser || 'admin')) && same(pass, String(c.portalPassword))) return
+  setResponseHeader(event, 'WWW-Authenticate', 'Basic realm="Lending portal"')
+  throw createError({ statusCode: 401, statusMessage: 'Login required' })
+})
