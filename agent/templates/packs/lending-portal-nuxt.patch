+++ b/server/api/loans/[id].get.ts
@@ -0,0 +1,18 @@
+import { fineract, money, fdate, ownerOf } from '~~/server/utils/fineract'
+
+export default defineEventHandler(async (event) => {
+  const id = getRouterParam(event, 'id')
+  const l = await fineract<any>(`/loans/${id}`, { query: { associations: 'repaymentSchedule,transactions' } })
+  const cur = l.currency?.code
+  return {
+    id: l.id, account: l.accountNo, client: l.clientName, product: l.loanProductName, status: l.status?.value,
+    officer: l.loanOfficerName ?? '', rate: `${l.interestRatePerPeriod}% ${l.interestRateFrequencyType?.value ?? ''}`.trim(),
+    principal: money(Number(l.principal), cur), outstanding: money(Number(l.summary?.totalOutstanding ?? 0), cur), overdue: money(Number(l.summary?.totalOverdue ?? 0), cur),
+    investor: await ownerOf(l.id),
+    schedule: (l.repaymentSchedule?.periods ?? []).filter((p: any) => p.period).map((p: any) => ({
+      period: p.period, due: fdate(p.dueDate), principal: money(Number(p.principalDue ?? 0), cur), interest: money(Number(p.interestDue ?? 0), cur),
+      total: money(Number(p.totalDueForPeriod ?? 0), cur), paid: money(Number(p.totalPaidForPeriod ?? 0), cur), status: p.complete ? 'paid' : (p.totalOverdue ?? 0) > 0 ? 'overdue' : 'due'
+    })),
+    transactions: (l.transactions ?? []).slice(-20).reverse().map((t: any) => ({ date: fdate(t.date), type: t.type?.value, amount: money(Number(t.amount ?? 0), cur) }))
+  }
+})
