@@ -0,0 +1,27 @@
+<script setup lang="ts">
+// A searchable table of plain rows; columns: [{ key, label }]. Rows link to `to(row)` when given.
+const props = defineProps<{ rows: Record<string, any>[] | null | undefined, columns: { key: string, label: string }[], to?: (row: any) => string, placeholder?: string }>()
+const q = ref('')
+const shown = computed(() => (props.rows ?? []).filter(r => !q.value || Object.values(r).join(' ').toLowerCase().includes(q.value.toLowerCase())))
+</script>
+
+<template>
+  <div class="flex flex-col gap-3">
+    <UInput v-model="q" class="max-w-sm" icon="i-lucide-search" :placeholder="placeholder ?? 'Search…'" />
+    <div class="overflow-x-auto rounded-lg border border-default">
+      <table class="w-full text-sm">
+        <thead class="bg-elevated/50 text-muted">
+          <tr><th v-for="c in columns" :key="c.key" class="px-3 py-2 text-left font-medium whitespace-nowrap">{{ c.label }}</th></tr>
+        </thead>
+        <tbody>
+          <tr v-for="(r, i) in shown" :key="i" class="border-t border-default hover:bg-elevated/30" :class="to ? 'cursor-pointer' : ''" @click="to && navigateTo(to(r))">
+            <td v-for="c in columns" :key="c.key" class="px-3 py-2 whitespace-nowrap">
+              <slot :name="c.key" :row="r">{{ r[c.key] }}</slot>
+            </td>
+          </tr>
+          <tr v-if="!shown.length"><td :colspan="columns.length" class="px-3 py-6 text-center text-muted">Nothing to show.</td></tr>
+        </tbody>
+      </table>
+    </div>
+  </div>
+</template>
