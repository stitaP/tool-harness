+    id: l.id,
+    account: l.accountNo,
+    client: l.clientName ?? '',
+    product: l.loanProductName ?? '',
+    status: l.status?.value ?? '',
+    active: !!l.status?.active,
+    principal: money(Number(l.principal), l.currency?.code),
+    outstanding: money(outstandingOf(l), l.currency?.code),
+    overdue: overdueOf(l) > 0 ? money(overdueOf(l), l.currency?.code) : '',
+    officer: l.loanOfficerName ?? '',
+    disbursed: fdate(l.timeline?.actualDisbursementDate)
+  }))
+}, { maxAge: 60 })
