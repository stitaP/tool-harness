+// Who gets which update. Borrowers' numbers come from Fineract (client mobileNo); collectors are the loan officer
+// (Fineract staff mobileNo) unless overridden here; investors are external asset owners mapped to a number here.
+import { readFileSync, existsSync } from 'node:fs'
+import { join } from 'node:path'
+
+export interface Contacts { investors: Record<string, { name: string; phone: string }>; collectors: Record<string, { name: string; phone: string }> }
+
+export function contacts(): Contacts {
+  const f = join(process.cwd(), 'data', 'contacts.json')
+  try {
+    return existsSync(f) ? JSON.parse(readFileSync(f, 'utf8')) : { investors: {}, collectors: {} }
+  } catch {
+    return { investors: {}, collectors: {} }
+  }
+}
diff --git a/server/utils/finance.ts b/server/utils/finance.ts
new file mode 100644
index 0000000..ccc8cc8
--- /dev/null
+++ b/server/utils/finance.ts
@@ -0,0 +1,61 @@
+// Loan arithmetic used by the calculators and reminders (same formulas as stitaP's finance_calc tool).
+
+/** EMI for a reducing-balance loan: P·r·(1+r)^n / ((1+r)^n − 1), r = monthly rate. */
+export function emi(principal: number, annualRatePct: number, months: number): number {
+  const r = annualRatePct / 12 / 100
+  if (!months) return 0
+  if (r === 0) return principal / months
+  const f = Math.pow(1 + r, months)
+  return (principal * r * f) / (f - 1)
+}
+
+export interface Row { month: number; emi: number; interest: number; principal: number; balance: number }
+
+export function schedule(principal: number, annualRatePct: number, months: number): Row[] {
+  const r = annualRatePct / 12 / 100
+  const e = emi(principal, annualRatePct, months)
+  const rows: Row[] = []
+  let bal = principal
+  for (let m = 1; m <= months; m++) {
+    const interest = bal * r
+    const princ = m === months ? bal : e - interest
+    bal = Math.max(0, bal - princ)
+    rows.push({ month: m, emi: round(princ + interest), interest: round(interest), principal: round(princ), balance: round(bal) })
+  }
+  return rows
+}
+
+/** Flat interest: interest on the full principal for the whole term. */
+export function flat(principal: number, annualRatePct: number, months: number) {
+  const interest = principal * annualRatePct / 100 * months / 12
+  return { emi: round((principal + interest) / months), totalInterest: round(interest), total: round(principal + interest) }
+}
+
+/** Part-prepayment after `afterMonth` EMIs: keep the EMI and shorten the term, or keep the term and lower the EMI. */
+export function prepay(principal: number, annualRatePct: number, months: number, afterMonth: number, amount: number) {
+  const rows = schedule(principal, annualRatePct, months)
+  const paid = rows.slice(0, afterMonth)
+  const bal = Math.max(0, (rows[afterMonth - 1]?.balance ?? principal) - amount)
+  const e = emi(principal, annualRatePct, months)
+  const r = annualRatePct / 12 / 100
+  const left = months - afterMonth
+  const newMonths = r === 0 ? Math.ceil(bal / e) : Math.ceil(-Math.log(1 - (bal * r) / e) / Math.log(1 + r))
+  const before = rows.reduce((s, x) => s + x.interest, 0)
+  const paidInterest = paid.reduce((s, x) => s + x.interest, 0)
+  const shorter = paidInterest + schedule(bal, annualRatePct, newMonths).reduce((s, x) => s + x.interest, 0)
+  const lower = paidInterest + schedule(bal, annualRatePct, left).reduce((s, x) => s + x.interest, 0)
+  return {
+    balanceAfterPrepayment: round(bal),
+    keepEmi: { months: afterMonth + newMonths, monthsSaved: left - newMonths, interestSaved: round(before - shorter) },
+    keepTerm: { newEmi: round(emi(bal, annualRatePct, left)), interestSaved: round(before - lower) }
+  }
+}
+
+/** Largest loan whose EMI keeps total obligations within `foirPct` of income (FOIR, used by Indian lenders/NBFCs). */
+export function eligibility(monthlyIncome: number, existingEmis: number, annualRatePct: number, months: number, foirPct = 50) {
+  const room = Math.max(0, monthlyIncome * foirPct / 100 - existingEmis)
+  const perRupee = emi(1, annualRatePct, months)
+  return { maxEmi: round(room), maxLoan: round(perRupee ? room / perRupee : 0) }
+}
+
+const round = (n: number) => Math.round(n * 100) / 100
diff --git a/server/utils/fineract.ts b/server/utils/fineract.ts
new file mode 100644
index 0000000..8bd6f53
--- /dev/null
+++ b/server/utils/fineract.ts
@@ -0,0 +1,56 @@
+// Apache Fineract (core banking / lending) REST client. Credentials stay on the server.
+import { createError } from 'h3'
+
+type Doc = Record<string, any>
+
+function cfg() {
+  const c = useRuntimeConfig()
+  return {
+    base: String(c.fineractUrl || 'https://demo.mifos.community/fineract-provider/api/v1').replace(/\/+$/, ''),
+    tenant: String(c.fineractTenant || 'default'),
+    auth: 'Basic ' + Buffer.from(`${c.fineractUser || 'mifos'}:${c.fineractPassword || 'password'}`).toString('base64')
+  }
+}
+
+export async function fineract<T = Doc>(path: string, opts: { method?: 'GET' | 'POST' | 'PUT'; query?: Record<string, any>; body?: any } = {}): Promise<T> {
+  const { base, tenant, auth } = cfg()
+  try {
+    return await $fetch<T>(`${base}${path}`, { method: opts.method ?? 'GET', query: opts.query, body: opts.body, headers: { 'Authorization': auth, 'Fineract-Platform-TenantId': tenant }, timeout: 30000 })
+  } catch (error: any) {
+    throw createError({ statusCode: error?.statusCode || 502, statusMessage: error?.data?.defaultUserMessage || error?.data?.errors?.[0]?.defaultUserMessage || error?.message || 'Fineract request failed' })
+  }
+}
+
+/** Loans with their summaries (outstanding, overdue). Fineract pages with offset/limit. */
+export async function allLoans(max = 500): Promise<Doc[]> {
+  const out: Doc[] = []
+  for (let offset = 0; out.length < max; offset += 200) {
+    const page = await fineract<{ pageItems?: Doc[] }>('/loans', { query: { offset, limit: 200 } })
+    const items = page.pageItems ?? []
+    out.push(...items)
+    if (items.length < 200) break
+  }
+  return out.slice(0, max)
+}
+
+export const isActive = (l: Doc) => !!l.status?.active
+export const overdueOf = (l: Doc) => Number(l.summary?.totalOverdue ?? 0)
+export const outstandingOf = (l: Doc) => Number(l.summary?.totalOutstanding ?? 0)
+
+export function money(n: number, currency = 'INR') {
+  return new Intl.NumberFormat(currency === 'INR' ? 'en-IN' : 'en-US', { style: 'currency', currency, maximumFractionDigits: 0 }).format(n || 0)
+}
+
+/** Fineract dates come as [yyyy, m, d]. */
+export const fdate = (d: any) => (Array.isArray(d) ? `${d[0]}-${String(d[1]).padStart(2, '0')}-${String(d[2]).padStart(2, '0')}` : d ?? '')
+
+/** Current investor (external asset owner) of a loan, if it was sold. */
+export async function ownerOf(loanId: number | string): Promise<{ owner: string; status: string } | null> {
+  try {
+    const r = await fineract<{ content?: Doc[] }>(`/external-asset-owners/transfers`, { query: { loanId } })
+    const t = (r.content ?? []).find((x) => x.status === 'ACTIVE') ?? null
+    return t ? { owner: String(t.owner?.externalId ?? t.ownerExternalId ?? ''), status: t.status } : null
+  } catch {
+    return null
+  }
+}
