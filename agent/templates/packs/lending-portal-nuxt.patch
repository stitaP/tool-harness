+++ b/server/utils/notify.ts
@@ -0,0 +1,71 @@
+// Turns lending events into WhatsApp updates for the borrower, the investor who owns the loan, and the collector.
+// Template names and their {{n}} parameters must match templates approved in WhatsApp Manager (see README-LENDING.md).
+import { fineract, money, fdate, ownerOf } from './fineract'
+import { contacts } from './contacts'
+import { normalizePhone, sendTemplate, type Sent } from './whatsapp'
+
+type Doc = Record<string, any>
+
+interface People { borrower?: { name: string; phone: string | null }; collector?: { name: string; phone: string | null }; investor?: { name: string; phone: string | null } }
+
+async function peopleOf(loan: Doc): Promise<People> {
+  const book = contacts()
+  const client = loan.clientId ? await fineract<Doc>(`/clients/${loan.clientId}`).catch(() => null) : null
+  let collector: People['collector']
+  if (loan.loanOfficerId) {
+    const o = book.collectors[String(loan.loanOfficerId)]
+    const staff = o ? null : await fineract<Doc>(`/staff/${loan.loanOfficerId}`).catch(() => null)
+    collector = { name: o?.name ?? loan.loanOfficerName ?? staff?.displayName ?? 'Collector', phone: normalizePhone(o?.phone ?? staff?.mobileNo) }
+  }
+  const own = await ownerOf(loan.id)
+  const inv = own ? book.investors[own.owner] : undefined
+  return {
+    borrower: { name: client?.displayName ?? loan.clientName ?? 'Customer', phone: normalizePhone(client?.mobileNo) },
+    collector,
+    investor: inv ? { name: inv.name, phone: normalizePhone(inv.phone) } : undefined
+  }
+}
+
+async function send(p: { name: string; phone: string | null } | undefined, role: string, template: string, params: string[], preview: string, out: Sent[]) {
+  if (!p?.phone) return
+  out.push(await sendTemplate(p.phone, role, template, params, preview))
+}
+
+/** A Fineract event on a loan (from the Web hook): DISBURSE, REPAYMENT, APPROVE, … */
+export async function notifyLoanEvent(action: string, loanId: number | string, amount?: number): Promise<Sent[]> {
+  const loan = await fineract<Doc>(`/loans/${loanId}`, { query: { associations: 'repaymentSchedule' } })
+  const cur = loan.currency?.code ?? 'INR'
+  const ppl = await peopleOf(loan)
+  const out: Sent[] = []
+  const acct = String(loan.accountNo)
+  const outstanding = money(Number(loan.summary?.totalOutstanding ?? 0), cur)
+  const a = action.toUpperCase()
+  if (a === 'DISBURSE') {
+    const next = (loan.repaymentSchedule?.periods ?? []).find((x: Doc) => x.period && !x.complete)
+    const amt = money(Number(loan.principal), cur)
+    const due = next ? `${money(Number(next.totalDueForPeriod), cur)} on ${fdate(next.dueDate)}` : '-'
+    await send(ppl.borrower, 'borrower', 'loan_disbursed', [ppl.borrower?.name ?? '', amt, acct, due], `Hi ${ppl.borrower?.name}, your loan ${acct} of ${amt} is disbursed. First instalment: ${due}.`, out)
+    await send(ppl.investor, 'investor', 'investor_update', [ppl.investor?.name ?? '', acct, 'disbursed', amt], `Loan ${acct} you fund was disbursed: ${amt}.`, out)
+  } else if (a === 'REPAYMENT') {
+    const paid = money(Number(amount ?? 0), cur)
+    await send(ppl.borrower, 'borrower', 'payment_received', [ppl.borrower?.name ?? '', paid, acct, outstanding], `Thank you ${ppl.borrower?.name}: ${paid} received for loan ${acct}. Outstanding: ${outstanding}.`, out)
+    await send(ppl.investor, 'investor', 'investor_update', [ppl.investor?.name ?? '', acct, 'repayment received', paid], `Repayment of ${paid} received on loan ${acct}.`, out)
+    await send(ppl.collector, 'collector', 'collection_update', [ppl.collector?.name ?? '', ppl.borrower?.name ?? '', paid, outstanding], `${ppl.borrower?.name} paid ${paid} on ${acct}; outstanding ${outstanding}.`, out)
+  } else {
+    await send(ppl.borrower, 'borrower', 'loan_status', [ppl.borrower?.name ?? '', acct, loan.status?.value ?? a], `Loan ${acct}: ${loan.status?.value ?? a}.`, out)
+  }
+  return out
+}
+
+/** Overdue reminders: borrower, collector (with the borrower's number) and investor. */
+export async function notifyOverdue(loan: Doc): Promise<Sent[]> {
+  const cur = loan.currency?.code ?? 'INR'
+  const overdue = money(Number(loan.summary?.totalOverdue ?? 0), cur)
+  const ppl = await peopleOf(loan)
+  const out: Sent[] = []
+  const acct = String(loan.accountNo)
+  await send(ppl.borrower, 'borrower', 'payment_overdue', [ppl.borrower?.name ?? '', overdue, acct], `Reminder: ${overdue} is overdue on your loan ${acct}.`, out)
+  await send(ppl.collector, 'collector', 'collector_overdue', [ppl.collector?.name ?? '', ppl.borrower?.name ?? '', ppl.borrower?.phone ?? '-', overdue, acct], `Follow up: ${ppl.borrower?.name} (${ppl.borrower?.phone ?? 'no number'}) owes ${overdue} on ${acct}.`, out)
+  await send(ppl.investor, 'investor', 'investor_update', [ppl.investor?.name ?? '', acct, 'overdue', overdue], `Loan ${acct} you fund is overdue: ${overdue}.`, out)
+  return out
+}
diff --git a/server/utils/whatsapp.ts b/server/utils/whatsapp.ts
new file mode 100644
index 0000000..84707f9
--- /dev/null
+++ b/server/utils/whatsapp.ts
@@ -0,0 +1,51 @@
+// WhatsApp updates through Meta's official WhatsApp Business Cloud API.
+// Without WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID nothing is sent: messages are recorded (dry run) so the
+// flow can be tested; the log feeds the dashboard's notifications.
+
+export interface Sent { id: number; to: string; role: string; template: string; params: string[]; text: string; status: 'sent' | 'dry-run' | 'failed'; error?: string; at: string }
+
+const log: Sent[] = []
+let seq = 0
+
+export const sentLog = () => log.slice().reverse()
+
+/**
+ * WhatsApp wants the full international number without '+': 919876543210. "+…" or "00…" numbers are taken as
+ * international; a 10-digit local number (after dropping leading zeros) gets WHATSAPP_DEFAULT_CC (91); anything
+ * else is used as written (store numbers with their country code to avoid guessing).
+ */
+export function normalizePhone(raw: string | null | undefined): string | null {
+  const s = String(raw ?? '').trim()
+  if (/^(\+|00)/.test(s)) { const d = s.replace(/\D/g, '').replace(/^00/, ''); return d.length >= 8 ? d : null }
+  const local = s.replace(/\D/g, '').replace(/^0+/, '')
+  if (local.length < 8) return null
+  return local.length === 10 ? String(useRuntimeConfig().whatsappDefaultCc || '91') + local : local
+}
+
+/**
+ * Send an approved template message. Outside a 24-hour customer-service window WhatsApp only delivers
+ * pre-approved templates, so every update here is a template with numbered parameters ({{1}}, {{2}}…).
+ */
+export async function sendTemplate(to: string, role: string, template: string, params: string[], preview: string): Promise<Sent> {
+  const c = useRuntimeConfig()
+  const entry: Sent = { id: ++seq, to, role, template, params, text: preview, status: 'dry-run', at: new Date().toISOString() }
+  if (c.whatsappToken && c.whatsappPhoneNumberId) {
+    try {
+      await $fetch(`https://graph.facebook.com/${c.whatsappApiVersion || 'v21.0'}/${c.whatsappPhoneNumberId}/messages`, {
+        method: 'POST',
+        headers: { Authorization: `Bearer ${c.whatsappToken}` },
+        body: {
+          messaging_product: 'whatsapp', to, type: 'template',
+          template: { name: template, language: { code: c.whatsappLanguage || 'en' }, components: [{ type: 'body', parameters: params.map(text => ({ type: 'text', text })) }] }
+        }
+      })
+      entry.status = 'sent'
+    } catch (e: any) {
+      entry.status = 'failed'
+      entry.error = e?.data?.error?.message || e?.message
+    }
+  }
+  log.push(entry)
+  if (log.length > 500) log.shift()
+  return entry
+}
