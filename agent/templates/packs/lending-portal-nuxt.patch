--- /dev/null
+++ b/server/api/calc.post.ts
@@ -0,0 +1,13 @@
+import { emi, schedule, flat, prepay, eligibility } from '~~/server/utils/finance'
+
+export default defineEventHandler(async (event) => {
+  const b = await readBody<Record<string, any>>(event)
+  const P = Number(b.principal), R = Number(b.rate), N = Number(b.months)
+  switch (b.kind) {
+    case 'emi': { const rows = schedule(P, R, N); const total = rows.reduce((s, r) => s + r.emi, 0); return { emi: Math.round(emi(P, R, N) * 100) / 100, totalInterest: Math.round((total - P) * 100) / 100, total: Math.round(total * 100) / 100, schedule: rows } }
+    case 'flat': return { ...flat(P, R, N), reducingEmi: Math.round(emi(P, R, N) * 100) / 100 }
+    case 'prepay': return prepay(P, R, N, Number(b.afterMonth), Number(b.amount))
+    case 'eligibility': return eligibility(Number(b.income), Number(b.existingEmis ?? 0), R, N, Number(b.foir ?? 50))
+    default: throw createError({ statusCode: 400, statusMessage: 'kind must be emi, flat, prepay or eligibility' })
+  }
+})
