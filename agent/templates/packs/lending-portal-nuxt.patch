+import { allLoans, isActive, outstandingOf, overdueOf, money } from '~~/server/utils/fineract'
+
+/** Overdue loans, largest first: the collectors' worklist. */
+export default defineCachedEventHandler(async () => {
+  return (await allLoans()).filter(l => isActive(l) && overdueOf(l) > 0)
+    .sort((a, b) => overdueOf(b) - overdueOf(a))
+    .map(l => ({
+      id: l.id, account: l.accountNo, client: l.clientName ?? '', officer: l.loanOfficerName ?? 'unassigned',
+      overdue: money(overdueOf(l), l.currency?.code), outstanding: money(outstandingOf(l), l.currency?.code),
+      daysOverdue: l.summary?.overdueSinceDate ? Math.max(0, Math.round((Date.now() - new Date(...(l.summary.overdueSinceDate as [number, number, number]).map((v: number, i: number) => (i === 1 ? v - 1 : v)) as [number, number, number]).getTime()) / 86400000)) : null
+    }))
+}, { maxAge: 60 })
